# ─── graphify personal fork — environment variable reference ───────────────
# Copy to .env and load with: export $(cat .env | xargs)
# Never commit .env to git.

# ── Backend selection ──────────────────────────────────────────────────────
# Always set this explicitly. Do NOT rely on auto-detection.
# Options: claude | ollama | openai | gemini | azure | bedrock
# Recommended for personal use: claude
# Recommended for client/sensitive work: ollama (fully local)
# GRAPHIFY_BACKEND=claude   # set --backend flag instead; env var not natively supported

# ── API Keys (set only the one you use) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# MOONSHOT_API_KEY=...       # Kimi — avoid for sensitive work (China-based)
# DEEPSEEK_API_KEY=...       # DeepSeek — avoid for sensitive work (China-based)

# ── Personal hardening controls (added in this fork) ──────────────────────

# Restrict auto-backend detection to only these backends (comma-separated).
# Prevents accidental routing to DeepSeek/Kimi when multiple keys are set.
# Recommended: set this to only the backend(s) you actually use.
GRAPHIFY_ALLOWED_BACKENDS=claude,ollama

# Suppress the corpus-destination warning after you've read and acknowledged it.
# Set to 1 once you understand that files are sent to the configured LLM backend.
# GRAPHIFY_SUPPRESS_CORPUS_WARNING=1

# Confirm hook installation. Must be set to 1 to run `graphify hook install`.
# WARNING: only install hooks in personal repos — NOT client project repos.
# GRAPHIFY_CONFIRM_HOOK_INSTALL=1

# ── Ollama (local model) settings ─────────────────────────────────────────
# Use this for client/sensitive corpora — fully local, no data leaves your machine.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b

# ── Output / performance tuning ───────────────────────────────────────────
# GRAPHIFY_MAX_OUTPUT_TOKENS=16384
# GRAPHIFY_API_TIMEOUT=600
